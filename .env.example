POSTGRES_USER=irsocial
POSTGRES_PASSWORD=changeme
POSTGRES_DB=irsocial

# Portas publicadas no computador. Ajuste se outra instancia ja usar as padroes.
DB_PORT=5432
APP_PORT=8080

# Usada pelo backend (server.js -> pg.Pool). Host "db" é o nome do serviço no docker-compose.
DATABASE_URL=postgres://irsocial:changeme@db:5432/irsocial

# Importacao de 2025 ao iniciar a aplicacao (compativel com a versao anterior).
# A rotina receita-sync importa os demais anos e acompanha novas publicacoes.
RECEITA_ANO=2025
RECEITA_AUTO_IMPORTAR=true

# Sincronizacao automatica e continua (servico receita-sync).
# Baixa os anos anteriores a partir de 2021 e descobre novos anos conforme publicados.
RECEITA_ANO_INICIAL=2021
# Verifica a cada 24 horas enquanto os conteineres estiverem ligados.
RECEITA_INTERVALO_HORAS=24
# Revalida os dois anos mais recentes para detectar revisoes oficiais.
RECEITA_REVISAR_ANOS=2
