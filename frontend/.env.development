# Enquanto a API de repasses não existe no backend, o frontend em modo dev
# usa dados demonstrativos (src/data/repassesMock.js).
# Mude para false quando os endpoints /api/repasses estiverem prontos.
VITE_USE_MOCK=true

# Opcional: URL base da API. Padrão: /api (com proxy do Vite para localhost:8080).
# VITE_API_URL=/api
